          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 99"
        },
        "puntuacion": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 10000"
        },
        "fecha": {
          ".validate": "newData.val() == now"
        },
        "dificultad": {
          ".validate": "newData.val() == 'dificil'"
        },
        "$other": {
          ".validate": false
        },
        "miembros": {
          "0": {
            ".validate": "newData.isString()"
          },
          "1": {
            ".validate": "newData.isString()"
          },
          "2": {
            ".validate": "newData.isString()"
          },
          ".validate": "newData.hasChildren(['0','1','2'])",
          "$other": {
            ".validate": false
          }
        },
        "sala": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{4}$/)"
        },
        "partida": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000000000000"
        }
      }
    },
    "records_coop_pesadilla": {
      ".read": true,
      ".indexOn": [
        "puntuacion"
      ],
      "$id": {
        ".write": "((auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('users').child(auth.uid).exists() && !root.child('accountCleanup').child(auth.uid).exists()) && newData.exists() && (auth.uid == newData.child('miembros/0').val() || auth.uid == newData.child('miembros/1').val() || auth.uid == newData.child('miembros/2').val())) || (auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && !newData.exists() && root.child('accountCleanup').child(auth.uid).exists() && ((auth.uid == data.child('miembros/0').val() || auth.uid == data.child('miembros/1').val() || auth.uid == data.child('miembros/2').val())))",
        ".validate": "newData.hasChildren([\"uid\",\"nombre\",\"avatar\",\"nivel\",\"puntuacion\",\"fecha\",\"dificultad\",\"miembros\",\"sala\",\"partida\"]) && newData.child('uid').val() == newData.child('uid').val() && newData.child('nombre').val() == root.child('users').child(newData.child('uid').val()).child('nombre').val() && newData.child('avatar').val() == root.child('users').child(newData.child('uid').val()).child('avatar').val() && newData.child('nivel').val() == root.child('users').child(newData.child('uid').val()).child('nivel').val() && newData.child('fecha').val() == now && newData.child('dificultad').val() == 'pesadilla' && (!data.exists() || newData.child('puntuacion').val() >= data.child('puntuacion').val()) && newData.child('uid').val() == newData.child('miembros').child('0').val() && $id == newData.child('miembros').child('0').val() + '|' + newData.child('miembros').child('1').val() + '|' + newData.child('miembros').child('2').val() && newData.child('miembros').child('0').val() < newData.child('miembros').child('1').val() && newData.child('miembros').child('1').val() < newData.child('miembros').child('2').val() && root.child('rooms').child(newData.child('sala').val()).child('meta/modo').val() == 'coop' && root.child('rooms').child(newData.child('sala').val()).child('meta/estado').val() == 'podium' && root.child('rooms').child(newData.child('sala').val()).child('meta/personalizada').val() == false && root.child('rooms').child(newData.child('sala').val()).child('meta/dificultad').val() == 'pesadilla' && root.child('rooms').child(newData.child('sala').val()).child('meta/match').val() == newData.child('partida').val() && root.child('rooms').child(newData.child('sala').val()).child('meta/pasillos').val() == newData.child('puntuacion').val() && root.child('rooms').child(newData.child('sala').val()).child('jugadores').child(newData.child('miembros').child('0').val()).exists() && newData.parent().parent().child('equipos').child(newData.child('miembros').child('0').val()).child('pesadilla').child($id).val() == true && root.child('rooms').child(newData.child('sala').val()).child('jugadores').child(newData.child('miembros').child('1').val()).exists() && newData.parent().parent().child('equipos').child(newData.child('miembros').child('1').val()).child('pesadilla').child($id).val() == true && root.child('rooms').child(newData.child('sala').val()).child('jugadores').child(newData.child('miembros').child('2').val()).exists() && newData.parent().parent().child('equipos').child(newData.child('miembros').child('2').val()).child('pesadilla').child($id).val() == true",
        "uid": {
          ".validate": "newData.isString()"
        },
        "nombre": {
          ".validate": "newData.isString()"
        },
        "avatar": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 12"
        },
        "nivel": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 99"
        },
        "puntuacion": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 10000"
        },
        "fecha": {
          ".validate": "newData.val() == now"
        },
        "dificultad": {
          ".validate": "newData.val() == 'pesadilla'"
        },
        "$other": {
          ".validate": false
        },
        "miembros": {
          "0": {
            ".validate": "newData.isString()"
          },
          "1": {
            ".validate": "newData.isString()"
          },
          "2": {
            ".validate": "newData.isString()"
          },
          ".validate": "newData.hasChildren(['0','1','2'])",
          "$other": {
            ".validate": false
          }
        },
        "sala": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{4}$/)"
        },
        "partida": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000000000000"
        }
      }
    },
    // Índice de equipos validado junto a su récord.
    "equipos": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
        "$d": {
          "$id": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((newData.val() == true && newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).exists() && (auth.uid == newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).child('miembros/0').val() || auth.uid == newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).child('miembros/1').val() || auth.uid == newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).child('miembros/2').val()) && ($uid == newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).child('miembros/0').val() || $uid == newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).child('miembros/1').val() || $uid == newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).child('miembros/2').val())) || (!newData.exists() && root.child('accountCleanup').child(auth.uid).exists() && (((auth.uid == root.child('records_coop_' + $d).child($id).child('miembros/0').val() || auth.uid == root.child('records_coop_' + $d).child($id).child('miembros/1').val() || auth.uid == root.child('records_coop_' + $d).child($id).child('miembros/2').val()) && !newData.parent().parent().parent().parent().child('records_coop_' + $d).child($id).exists()) || auth.uid == $uid && !root.child('records_coop_' + $d).child($id).exists())))",
            ".validate": "$d.matches(/^(facil|normal|dificil|pesadilla)$/) && newData.val() == true"
          }
        }
      }
    },
    // Índice propio para limpiar salas al eliminar la cuenta.
    "salasJugador": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid == $uid",
        "$code": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid == $uid && ((!newData.exists()) || (newData.val() == true && root.child('rooms').child($code).child('jugadores').child($uid).exists()))",
          ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.val() == true"
        }
      }
    },
    // Índice propio de invitaciones para limpiar al borrarse.
    "enviadas": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid == $uid",
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((auth.uid == $uid && newData.exists()) || (!newData.exists() && (auth.uid == $uid || auth.uid == data.child('dest').val())))",
          ".validate": "newData.hasChildren(['dest']) && newData.parent().parent().parent().child('invitaciones').child(newData.child('dest').val()).child($id).child('de').val() == $uid",
          "dest": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    // Índice de tiempos: limpieza de hasta ocho salas caducadas al conectarse.
    "caducidad": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      ".indexOn": [
        ".value"
      ],
      "$code": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((newData.isNumber() && newData.val() == root.child('rooms').child($code).child('meta/expiresAt').val()) || (!newData.exists() && (!root.child('rooms').child($code).exists() || root.child('rooms').child($code).child('meta/expiresAt').val() < now || root.child('accountCleanup').child(auth.uid).exists() && root.child('rooms').child($code).child('jugadores').child(auth.uid).exists())))",
        ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.isNumber()"
      }
    },
    // Solo UID eliminado: impide recrear el perfil con un token antiguo aún válido.
    "deletedAccounts": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid == $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid == $uid && !data.exists() && newData.val() == true && root.child('accountCleanup').child($uid).exists() && !newData.parent().parent().child('users').child($uid).exists()",
        ".validate": "newData.val() == true"
      }
    }
  }
}
