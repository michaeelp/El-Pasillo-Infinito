{
  "name": "el-pasillo-infinito",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Juego de terror y dibujo, solo y online",
  "scripts": {
    "test": "node tests/scoring.test.js && node tests/catalog.test.js && node tests/expansion4.test.js && node tools/validate_lore.mjs && node tools/update_rules.mjs --check && node tools/account_rules.mjs --check",
    "test:rules": "firebase emulators:exec --only database,auth,firestore --project demo-pasillo \"node tests/account-rules.cjs\"",
    "test:expansion": "firebase emulators:exec --only database,auth,firestore --project demo-pasillo \"node tests/accounts-ui.cjs\"",
    "generate:audio": "python3 tools/generate_audio.py",
    "generate:rules": "node tools/update_rules.mjs && node tools/account_rules.mjs",
    "generate:docs": "node tools/export_docs.mjs"
  },
  "devDependencies": {
    "firebase-tools": "14.22.0",
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "playwright": "^1.55.0",
    "esbuild": "0.25.12",
    "sharp": "^0.34.0"
  }
}
