rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['n', 'p', 't'])
        && request.resource.data.keys().hasOnly(['n', 'p', 't'])
        && request.resource.data.n is string
        && request.resource.data.n.size() >= 1
        && request.resource.data.n.size() <= 14
        && request.resource.data.p is int
        && request.resource.data.p >= 1
        && request.resource.data.p <= 500
        && request.resource.data.t is timestamp
        && request.resource.data.t == request.time;
      allow update, delete: if false;
    }
  }
}
